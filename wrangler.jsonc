{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitswitch-web-v3",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Prerendered "/" is normally served as a static asset before the Worker
  // ever runs, which skips src/start.ts's Host-based gateway for get.gitswitch.dev.
  // Force just "/" through the Worker; everything else (docs, assets) is untouched.
  "assets": { "run_worker_first": ["/"] },
  "observability": {
    "enabled": true
  }
}
